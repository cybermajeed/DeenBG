# Generated runtime data (preserve folder structure via .gitkeep)
cache/*
!cache/.gitkeep
logs/*
!logs/.gitkeep
wallpapers/*
!wallpapers/.gitkeep

# Python compiled files & bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp

# Local runtime configuration
config.json

# PyInstaller intermediate build directories
build/
*.spec
